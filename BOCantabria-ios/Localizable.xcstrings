      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir las secciones del boletín"
          }
        }
      }
    },
    "app_bar_search": {
      "comment": "Acción de buscar de la barra superior. Todavía anuncia «Próximamente»: el buscador llega con su feature.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar"
          }
        }
