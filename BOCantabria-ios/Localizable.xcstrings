      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BOC Cantabria"
          }
        }
      }
    },
    "chip_todays_bulletin": {
      "comment": "Primer chip de la fila de secciones. Dice lo que muestra: la última edición, no el archivo entero.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boletín de hoy"
          }
        }
      }
    },
    "chip_whole_section": {
      "comment": "Primera entrada de la fila de subsecciones: vuelve a la sección completa.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la sección"
          }
        }
      }
    },
    "coming_soon": {
      "comment": "Lo que dice toda acción o destino que todavía no hace nada.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximamente"
          }
        }
      }
    },
    "date_long": {
      "comment": "Formato largo español: día, mes y año. Es %lld y no %d: en 64 bits un Int no cabe en %d.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$@ de %3$lld"
          }
        }
      }
    },
    "home_bulletin_today": {
      "comment": "Denominación de la selección por defecto en la cabecera editorial.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boletín de hoy"
          }
        }
      }
    },
    "home_empty_section": {
      "comment": "Estado vacío de una sección. No es un error: hay secciones sin publicar desde hace años.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección no tiene publicaciones guardadas."
          }
        }
