# ---------- Secretos ----------
# La credencial del servicio de IA. El .example sí se versiona.
Config/Secrets.xcconfig

# Configuración de Firebase. NO se versiona, y la diferencia con Android es real: allí el
# google-services.json sí va en el repositorio porque la clave se restringe por paquete Y
# huella de firma; en iOS la restricción es solo por identificador de paquete, sin prueba
# criptográfica, así que ese razonamiento no se traslada. Se descarga de la consola del
# proyecto bocantabria-6e90f (app iOS com.jrblanco.BOCantabria) y en CI entra como secreto.
GoogleService-Info.plist

